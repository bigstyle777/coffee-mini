.page {
    padding-bottom: 220rpx;
}

.pickup-card,
.list-card,
.note-card,
.summary-card {
    padding: 28rpx;
    margin-bottom: 20rpx;
}

.pickup-title {
    font-size: 28rpx;
    font-weight: 600;
}

.chip-row {
    display: flex;
    margin-top: 20rpx;
}

.chip {
    padding: 16rpx 32rpx;
    margin-right: 16rpx;
    border: 2rpx solid #e8ddcf;
    border-radius: 16rpx;
    background: #fbf7f2;
    color: #3d2b1f;
    font-size: 26rpx;
}

.chip-active {
    border-color: #3d2b1f;
    background: #f3e8db;
    font-weight: 600;
}

.pickup-hint {
    display: block;
    margin-top: 16rpx;
    color: #b3a294;
    font-size: 22rpx;
}

.list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20rpx;
    border-bottom: 2rpx solid #f4ece2;
}

.discount-hint {
    color: #9a6534;
    font-size: 22rpx;
}

.line {
    display: flex;
    padding: 24rpx 0;
    border-bottom: 2rpx solid #f7f1e9;
}

.line:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.line-thumb {
    display: flex;
    width: 96rpx;
    height: 96rpx;
    align-items: center;
    flex-shrink: 0;
    border-radius: 16rpx;
    justify-content: center;
}

.line-thumb-text {
    color: rgba(255, 255, 255, 0.92);
    font-size: 40rpx;
    font-weight: 700;
}

.line-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin-left: 20rpx;
}

.line-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.line-name {
    font-size: 30rpx;
    font-weight: 600;
}

.line-remove {
    padding: 4rpx 8rpx;
    color: #b3a294;
    font-size: 22rpx;
}

.line-spec {
    margin-top: 8rpx;
    color: #8b7b6e;
    font-size: 22rpx;
    line-height: 1.5;
}

.line-note {
    margin-top: 6rpx;
    color: #9a6534;
    font-size: 22rpx;
}

.line-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16rpx;
}

.line-price {
    color: #3d2b1f;
    font-size: 30rpx;
    font-weight: 700;
}

.stepper {
    display: flex;
    align-items: center;
}

.stepper-btn {
    display: flex;
    width: 48rpx;
    height: 48rpx;
    align-items: center;
    border: 2rpx solid #e2d6c8;
    border-radius: 50%;
    color: #3d2b1f;
    font-size: 28rpx;
    justify-content: center;
    line-height: 1;
}

.stepper-btn-add {
    border-color: #3d2b1f;
    background: #3d2b1f;
    color: #fdf8f2;
}

.stepper-value {
    min-width: 56rpx;
    font-size: 26rpx;
    text-align: center;
}

.note-input {
    box-sizing: border-box;
    width: 100%;
    height: 120rpx;
    margin-top: 20rpx;
    padding: 20rpx;
    border-radius: 16rpx;
    background: #fbf7f2;
    font-size: 26rpx;
    line-height: 1.5;
}

.note-placeholder {
    color: #b3a294;
}

.summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10rpx 0;
}

.summary-label {
    color: #7a6a5c;
    font-size: 26rpx;
}

.summary-value {
    color: #3d2b1f;
    font-size: 26rpx;
}

.summary-value-accent {
    color: #b4453c;
}

.summary-row-total {
    padding-top: 20rpx;
    margin-top: 10rpx;
    border-top: 2rpx solid #f4ece2;
}

.summary-label-total {
    font-size: 28rpx;
    font-weight: 600;
}

.summary-total {
    color: #3d2b1f;
    font-size: 38rpx;
    font-weight: 700;
}

.bottom-bar {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    padding: 20rpx 28rpx 40rpx;
    background: #fdf9f4;
    box-shadow: 0 -8rpx 24rpx rgba(74, 48, 30, 0.06);
}

.bottom-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.bottom-total {
    color: #3d2b1f;
    font-size: 38rpx;
    font-weight: 700;
}

.bottom-hint {
    color: #b3a294;
    font-size: 22rpx;
}

.submit-button {
    padding: 24rpx 56rpx;
    border-radius: 999rpx;
    background: #3d2b1f;
    color: #fdf8f2;
    font-size: 30rpx;
    font-weight: 600;
}

.submit-button-busy {
    opacity: 0.6;
}

.primary-button {
    margin-top: 32rpx;
    padding: 18rpx 48rpx;
    border-radius: 999rpx;
    background: #3d2b1f;
    color: #fdf8f2;
    font-size: 28rpx;
}
