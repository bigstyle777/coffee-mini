<view class="page">
    <view class="shop-head">
        <view class="shop-copy">
            <text class="shop-name">{{shopName}}</text>
            <text class="shop-meta">营业中 · {{shopHours}} · 出杯约 5 分钟</text>
        </view>
        <view class="orders-entry" bindtap="goOrders">
            <text class="orders-entry-text">我的订单</text>
        </view>
    </view>

    <scroll-view class="category-bar" scroll-x enable-flex show-scrollbar="{{false}}">
        <view
            class="category-item {{activeCategory === item.id ? 'category-item-active' : ''}}"
            wx:for="{{categories}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="handleCategoryTap"
        >
            {{item.name}}
        </view>
    </scroll-view>

    <view class="empty-block card" wx:if="{{viewState === 'empty'}}">
        <text class="empty-title">这个分类还没有上新</text>
        <text class="empty-text">换个分类看看，或者稍后再来。</text>
    </view>

    <view class="product-list" wx:else>
        <view
            class="product-card card {{item.offline ? 'product-card-offline' : ''}}"
            wx:for="{{products}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="handleProductTap"
        >
            <view class="product-thumb" style="background: {{item.gradient}}">
                <text class="product-thumb-text">{{item.short}}</text>
            </view>
            <view class="product-body">
                <view class="product-title-row">
                    <text class="product-name">{{item.name}}</text>
                    <text class="product-tag product-tag-offline" wx:if="{{item.offline}}">售罄</text>
                    <text class="product-tag" wx:elif="{{item.tag}}">{{item.tag}}</text>
                </view>
                <text class="product-en">{{item.en}}</text>
                <text class="product-desc">{{item.desc}}</text>
                <view class="product-foot">
                    <text class="product-price">{{item.priceText}}</text>
                    <view class="stepper" wx:if="{{item.offline}}">
                        <view class="stepper-btn stepper-btn-disabled">−</view>
                        <text class="stepper-value">0</text>
                        <view class="stepper-btn stepper-btn-disabled">+</view>
                    </view>
                    <view class="stepper" wx:else>
                        <view
                            class="stepper-btn"
                            wx:if="{{item.qty > 0}}"
                            data-id="{{item.id}}"
                            catchtap="handleMinus"
                        >−</view>
                        <text class="stepper-value" wx:if="{{item.qty > 0}}">{{item.qty}}</text>
                        <view class="stepper-btn stepper-btn-add" data-id="{{item.id}}" catchtap="handlePlus">+</view>
                    </view>
                </view>
            </view>
        </view>
    </view>

    <view class="cart-bar" wx:if="{{cartCount > 0}}">
        <view class="cart-badge">
            <text class="cart-badge-text">{{cartCount}}</text>
        </view>
        <view class="cart-copy" bindtap="goCart">
            <text class="cart-total">{{cartTotalText}}</text>
            <text class="cart-hint">点开确认明细</text>
        </view>
        <view class="cart-cta" bindtap="goCart">去结算</view>
    </view>
</view>
