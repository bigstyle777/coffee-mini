.page {
    padding-bottom: 220rpx;
}

.shop-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16rpx 8rpx 24rpx;
}

.shop-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.shop-name {
    font-size: 40rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
}

.shop-meta {
    margin-top: 8rpx;
    color: #8b7b6e;
    font-size: 24rpx;
}

.orders-entry {
    padding: 12rpx 24rpx;
    border: 2rpx solid #e2d6c8;
    border-radius: 999rpx;
    background: #ffffff;
}

.orders-entry-text {
    color: #7a4a2b;
    font-size: 24rpx;
}

.category-bar {
    width: 100%;
    margin-bottom: 24rpx;
    white-space: nowrap;
}

.category-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14rpx 28rpx;
    margin-right: 16rpx;
    border-radius: 999rpx;
    background: #ffffff;
    color: #7a6a5c;
    font-size: 26rpx;
}

.category-item-active {
    background: #3d2b1f;
    color: #fdf8f2;
    font-weight: 600;
}

.product-list {
    display: flex;
    flex-direction: column;
}

.product-card {
    display: flex;
    padding: 24rpx;
    margin-bottom: 20rpx;
}

.product-card-offline {
    opacity: 0.55;
}

.product-thumb {
    display: flex;
    width: 132rpx;
    height: 132rpx;
    align-items: center;
    flex-shrink: 0;
    border-radius: 20rpx;
    justify-content: center;
}

.product-thumb-text {
    color: rgba(255, 255, 255, 0.92);
    font-size: 52rpx;
    font-weight: 700;
}

.product-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin-left: 24rpx;
}

.product-title-row {
    display: flex;
    align-items: center;
}

.product-name {
    font-size: 32rpx;
    font-weight: 600;
}

.product-tag {
    margin-left: 12rpx;
    padding: 2rpx 12rpx;
    border-radius: 8rpx;
    background: #f6e7d5;
    color: #9a6534;
    font-size: 20rpx;
}

.product-tag-offline {
    background: #ece6df;
    color: #8b7b6e;
}

.product-en {
    margin-top: 4rpx;
    color: #b3a294;
    font-size: 20rpx;
    letter-spacing: 1rpx;
    text-transform: uppercase;
}

.product-desc {
    margin-top: 10rpx;
    color: #7a6a5c;
    font-size: 24rpx;
    line-height: 1.5;
}

.product-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16rpx;
}

.product-price {
    color: #3d2b1f;
    font-size: 32rpx;
    font-weight: 700;
}

.stepper {
    display: flex;
    align-items: center;
}

.stepper-btn {
    display: flex;
    width: 52rpx;
    height: 52rpx;
    align-items: center;
    border: 2rpx solid #e2d6c8;
    border-radius: 50%;
    color: #3d2b1f;
    font-size: 32rpx;
    justify-content: center;
    line-height: 1;
}

.stepper-btn-add {
    border-color: #3d2b1f;
    background: #3d2b1f;
    color: #fdf8f2;
}

.stepper-btn-disabled {
    border-color: #e8e1d9;
    background: #f2ece5;
    color: #b9ada1;
}

.stepper-value {
    min-width: 52rpx;
    color: #3d2b1f;
    font-size: 28rpx;
    text-align: center;
}

.cart-bar {
    position: fixed;
    right: 28rpx;
    bottom: 32rpx;
    left: 28rpx;
    display: flex;
    align-items: center;
    padding: 20rpx 20rpx 20rpx 28rpx;
    border-radius: 999rpx;
    background: #2f2620;
    box-shadow: 0 16rpx 40rpx rgba(47, 38, 32, 0.28);
}

.cart-badge {
    display: flex;
    width: 56rpx;
    height: 56rpx;
    align-items: center;
    border-radius: 50%;
    background: #d9a066;
    justify-content: center;
}

.cart-badge-text {
    color: #2f2620;
    font-size: 26rpx;
    font-weight: 700;
}

.cart-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin-left: 20rpx;
}

.cart-total {
    color: #fdf8f2;
    font-size: 32rpx;
    font-weight: 700;
}

.cart-hint {
    color: rgba(253, 248, 242, 0.6);
    font-size: 20rpx;
}

.cart-cta {
    padding: 18rpx 40rpx;
    border-radius: 999rpx;
    background: #d9a066;
    color: #2f2620;
    font-size: 28rpx;
    font-weight: 600;
}
