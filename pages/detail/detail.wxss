.page {
    padding-bottom: 220rpx;
}

.hero {
    display: flex;
    height: 320rpx;
    align-items: center;
    border-radius: 28rpx;
    flex-direction: column;
    justify-content: center;
}

.hero-short {
    color: rgba(255, 255, 255, 0.94);
    font-size: 110rpx;
    font-weight: 700;
    line-height: 1.1;
}

.hero-en {
    margin-top: 12rpx;
    color: rgba(255, 255, 255, 0.7);
    font-size: 24rpx;
    letter-spacing: 4rpx;
    text-transform: uppercase;
}

.offline-banner {
    padding: 20rpx 28rpx;
    margin-top: 20rpx;
    border-radius: 16rpx;
    background: #f3ece3;
}

.offline-banner-text {
    color: #8b7b6e;
    font-size: 24rpx;
}

.intro {
    padding: 28rpx;
    margin-top: 20rpx;
}

.intro-title-row {
    display: flex;
    align-items: center;
}

.intro-name {
    font-size: 40rpx;
    font-weight: 700;
}

.product-tag {
    margin-left: 16rpx;
    padding: 4rpx 14rpx;
    border-radius: 8rpx;
    background: #f6e7d5;
    color: #9a6534;
    font-size: 20rpx;
}

.intro-desc {
    display: block;
    margin-top: 12rpx;
    color: #7a6a5c;
    font-size: 26rpx;
    line-height: 1.6;
}

.intro-base {
    display: block;
    margin-top: 16rpx;
    color: #b3a294;
    font-size: 24rpx;
}

.option-card {
    padding: 28rpx;
    margin-top: 20rpx;
}

.option-title {
    font-size: 28rpx;
    font-weight: 600;
}

.chip-row {
    display: flex;
    margin-top: 20rpx;
    flex-wrap: wrap;
}

.chip {
    display: flex;
    align-items: center;
    padding: 16rpx 28rpx;
    margin: 0 16rpx 16rpx 0;
    border: 2rpx solid #e8ddcf;
    border-radius: 16rpx;
    background: #fbf7f2;
}

.chip-active {
    border-color: #3d2b1f;
    background: #f3e8db;
}

.chip-name {
    color: #3d2b1f;
    font-size: 26rpx;
}

.chip-extra {
    margin-left: 10rpx;
    color: #9a6534;
    font-size: 22rpx;
}

.extra-list {
    margin-top: 12rpx;
}

.extra-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 0;
    border-bottom: 2rpx solid #f4ece2;
}

.extra-row:last-child {
    border-bottom: none;
}

.extra-name {
    font-size: 28rpx;
}

.extra-right {
    display: flex;
    align-items: center;
}

.extra-price {
    margin-right: 20rpx;
    color: #9a6534;
    font-size: 24rpx;
}

.checkbox {
    display: flex;
    width: 44rpx;
    height: 44rpx;
    align-items: center;
    border: 2rpx solid #d8c9b8;
    border-radius: 50%;
    justify-content: center;
}

.checkbox-on {
    border-color: #3d2b1f;
    background: #3d2b1f;
}

.checkbox-mark {
    color: #fdf8f2;
    font-size: 24rpx;
}

.note-input {
    box-sizing: border-box;
    width: 100%;
    height: 140rpx;
    margin-top: 20rpx;
    padding: 20rpx;
    border-radius: 16rpx;
    background: #fbf7f2;
    font-size: 26rpx;
    line-height: 1.5;
}

.note-placeholder {
    color: #b3a294;
}

.bottom-bar {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    padding: 20rpx 28rpx 40rpx;
    background: #fdf9f4;
    box-shadow: 0 -8rpx 24rpx rgba(74, 48, 30, 0.06);
}

.qty-stepper {
    display: flex;
    align-items: center;
    padding: 0 12rpx;
}

.stepper-btn {
    display: flex;
    width: 56rpx;
    height: 56rpx;
    align-items: center;
    border: 2rpx solid #e2d6c8;
    border-radius: 50%;
    color: #3d2b1f;
    font-size: 34rpx;
    justify-content: center;
    line-height: 1;
}

.stepper-btn-add {
    border-color: #3d2b1f;
    background: #3d2b1f;
    color: #fdf8f2;
}

.stepper-value {
    min-width: 64rpx;
    font-size: 30rpx;
    text-align: center;
}

.add-button {
    display: flex;
    height: 92rpx;
    align-items: center;
    border-radius: 999rpx;
    background: #3d2b1f;
    flex: 1;
    justify-content: center;
}

.add-button-price {
    color: #d9a066;
    font-size: 32rpx;
    font-weight: 700;
}

.add-button-text {
    margin-left: 16rpx;
    color: #fdf8f2;
    font-size: 30rpx;
}

.add-button-disabled {
    background: #b9ada1;
}

.back-home {
    margin-top: 32rpx;
    padding: 18rpx 48rpx;
    border-radius: 999rpx;
    background: #3d2b1f;
    color: #fdf8f2;
    font-size: 28rpx;
}
