<view class="page" wx:if="{{viewState === 'error'}}">
    <view class="empty-block card">
        <text class="empty-title">没有找到这笔订单</text>
        <text class="empty-text">可能是订单已被清理，回到订单页看看。</text>
        <view class="ghost-button" bindtap="goOrders">回到订单页</view>
    </view>
</view>

<view class="page" wx:elif="{{viewState === 'already'}}">
    <view class="empty-block card">
        <text class="empty-title">这笔订单不需要重复支付</text>
        <text class="empty-text">当前状态：{{order.statusText}}</text>
        <view class="ghost-button" bindtap="goOrders">回到订单页</view>
    </view>
</view>

<view class="page" wx:elif="{{viewState === 'ready'}}">
    <view class="amount-card card">
        <text class="amount-label">待支付金额</text>
        <text class="amount-value">{{totalText}}</text>
        <text class="amount-shop">{{order.pickupName}} · 共 {{order.itemCount}} 件</text>
    </view>

    <view class="detail-card card">
        <view class="detail-row">
            <text class="detail-label">订单号</text>
            <text class="detail-value">{{order.no}}</text>
        </view>
        <view class="detail-row">
            <text class="detail-label">商品小计</text>
            <text class="detail-value">{{subtotalText}}</text>
        </view>
        <view class="detail-row" wx:if="{{discountText}}">
            <text class="detail-label">满减优惠</text>
            <text class="detail-value detail-value-accent">{{discountText}}</text>
        </view>
        <view class="detail-line" wx:for="{{items}}" wx:key="key">
            <text class="detail-line-name">{{item.name}} ×{{item.qty}}</text>
            <text class="detail-line-price">{{item.priceText}}</text>
        </view>
    </view>

    <view class="pay-card card">
        <text class="pay-title">支付方式</text>
        <view class="pay-method">
            <view class="pay-icon">微</view>
            <view class="pay-method-copy">
                <text class="pay-method-name">微信支付</text>
                <text class="pay-method-hint" wx:if="{{mockPay}}">当前为模拟支付，不会产生真实扣款</text>
                <text class="pay-method-hint" wx:else>调用真实 wx.requestPayment</text>
            </view>
            <view class="pay-checked">✓</view>
        </view>
    </view>

    <view class="bottom-bar">
        <view class="cancel-button" bindtap="handleCancel">稍后再付</view>
        <view class="pay-button {{paying ? 'pay-button-busy' : ''}}" bindtap="handlePay">
            {{paying ? '支付中…' : '确认支付 ' + totalText}}
        </view>
    </view>
</view>
