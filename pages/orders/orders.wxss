.page {
    padding-bottom: 60rpx;
}

.page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8rpx 8rpx 24rpx;
}

.page-title {
    font-size: 40rpx;
    font-weight: 700;
}

.head-actions {
    display: flex;
    align-items: center;
}

.head-actions .admin-entry {
    margin-left: 12rpx;
}

.admin-entry {
    padding: 10rpx 24rpx;
    border: 2rpx solid #e2d6c8;
    border-radius: 999rpx;
    background: #ffffff;
}

.admin-entry-text {
    color: #7a4a2b;
    font-size: 24rpx;
}

.order-list {
    display: flex;
    flex-direction: column;
}

.order-card {
    padding: 28rpx;
    margin-bottom: 20rpx;
}

.order-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.order-head-copy {
    display: flex;
    flex-direction: column;
}

.order-no {
    color: #3d2b1f;
    font-size: 26rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
}

.order-time {
    margin-top: 8rpx;
    color: #b3a294;
    font-size: 22rpx;
}

.status-pill {
    padding: 8rpx 20rpx;
    border-radius: 999rpx;
    background: #f0e9e0;
}

.status-text {
    color: #6b5541;
    font-size: 22rpx;
    font-weight: 600;
}

.status-unpaid {
    background: #fbe4e1;
}

.status-unpaid .status-text {
    color: #b4453c;
}

.status-making {
    background: #fbebd5;
}

.status-making .status-text {
    color: #9a6534;
}

.status-ready {
    background: #e3efe0;
}

.status-ready .status-text {
    color: #4a6b45;
}

.status-cancelled {
    background: #f0ece7;
}

.status-cancelled .status-text {
    color: #a89b8e;
}

.order-hint {
    display: block;
    margin-top: 12rpx;
    color: #8b7b6e;
    font-size: 22rpx;
}

.order-items {
    margin-top: 20rpx;
    padding-top: 8rpx;
    border-top: 2rpx solid #f4ece2;
}

.order-item {
    padding: 18rpx 0;
    border-bottom: 2rpx solid #f9f3ec;
}

.order-item:last-child {
    border-bottom: none;
}

.order-item-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.order-item-name {
    font-size: 28rpx;
    font-weight: 500;
}

.order-item-qty {
    color: #8b7b6e;
    font-size: 24rpx;
}

.order-item-price {
    display: block;
    margin-top: 6rpx;
    color: #3d2b1f;
    font-size: 24rpx;
}

.order-item-spec {
    display: block;
    margin-top: 4rpx;
    color: #b3a294;
    font-size: 22rpx;
    line-height: 1.5;
}

.order-item-note {
    display: block;
    margin-top: 4rpx;
    color: #9a6534;
    font-size: 22rpx;
}

.order-note {
    padding: 16rpx 20rpx;
    margin-top: 8rpx;
    border-radius: 12rpx;
    background: #fbf7f2;
}

.order-note-text {
    color: #7a6a5c;
    font-size: 22rpx;
    line-height: 1.5;
}

.order-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 20rpx;
    padding-top: 20rpx;
    border-top: 2rpx solid #f4ece2;
}

.order-total {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
}

.order-total-label {
    color: #8b7b6e;
    font-size: 22rpx;
}

.order-discount {
    margin-left: 12rpx;
    color: #b4453c;
    font-size: 22rpx;
}

.order-total-value {
    margin-left: 16rpx;
    color: #3d2b1f;
    font-size: 32rpx;
    font-weight: 700;
}

.order-actions {
    display: flex;
    align-items: center;
}

.ghost-button {
    padding: 12rpx 26rpx;
    margin-left: 12rpx;
    border: 2rpx solid #e2d6c8;
    border-radius: 999rpx;
    color: #7a6a5c;
    font-size: 24rpx;
}

.ghost-button-danger {
    border-color: #efd5d2;
    color: #b4453c;
}

.solid-button {
    padding: 12rpx 30rpx;
    margin-left: 12rpx;
    border-radius: 999rpx;
    background: #3d2b1f;
    color: #fdf8f2;
    font-size: 24rpx;
}

.primary-button {
    margin-top: 32rpx;
    padding: 18rpx 48rpx;
    border-radius: 999rpx;
    background: #3d2b1f;
    color: #fdf8f2;
    font-size: 28rpx;
}
