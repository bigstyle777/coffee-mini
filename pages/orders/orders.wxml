<view class="page">
    <view class="page-head">
        <text class="page-title">订单与取餐</text>
        <view class="head-actions">
            <view class="admin-entry entry-about" bindtap="goAbout">
                <text class="admin-entry-text">关于</text>
            </view>
            <view class="admin-entry entry-admin" bindtap="goAdmin">
                <text class="admin-entry-text">店长端</text>
            </view>
        </view>
    </view>

    <view class="empty-block card" wx:if="{{viewState === 'empty'}}">
        <text class="empty-title">还没有订单</text>
        <text class="empty-text">下单后可以在这里看取餐进度。</text>
        <view class="primary-button" bindtap="goMenu">去点单</view>
    </view>

    <view class="empty-block card" wx:elif="{{viewState === 'error'}}">
        <text class="empty-title">订单读取失败</text>
        <text class="empty-text">数据没能从本机读出来，请重新进入页面。</text>
    </view>

    <view class="order-list" wx:elif="{{viewState === 'ready'}}">
        <view class="order-card card" wx:for="{{orders}}" wx:key="id">
            <view class="order-head">
                <view class="order-head-copy">
                    <text class="order-no">订单号 {{item.no}}</text>
                    <text class="order-time">{{item.timeText}} · {{item.pickupName}}</text>
                </view>
                <view class="status-pill status-{{item.status}}">
                    <text class="status-text">{{item.statusText}}</text>
                </view>
            </view>

            <text class="order-hint">{{item.statusHint}}</text>

            <view class="order-items">
                <view class="order-item" wx:for="{{item.items}}" wx:for-item="line" wx:key="key">
                    <view class="order-item-main">
                        <text class="order-item-name">{{line.name}}</text>
                        <text class="order-item-qty">×{{line.qty}}</text>
                    </view>
                    <text class="order-item-price">{{line.priceText}}</text>
                    <text class="order-item-spec">{{line.specText}}</text>
                    <text class="order-item-note" wx:if="{{line.note}}">备注：{{line.note}}</text>
                </view>
            </view>

            <view class="order-note" wx:if="{{item.note}}">
                <text class="order-note-text">整单备注：{{item.note}}</text>
            </view>

            <view class="order-foot">
                <view class="order-total">
                    <text class="order-total-label">共 {{item.itemCount}} 件</text>
                    <text class="order-discount" wx:if="{{item.discountText}}">已优惠 {{item.discountText}}</text>
                    <text class="order-total-value">{{item.totalText}}</text>
                </view>
                <view class="order-actions">
                    <view class="ghost-button" data-id="{{item.id}}" bindtap="handleReorder">再来一单</view>
                    <view class="ghost-button ghost-button-danger" wx:if="{{item.canCancel}}" data-id="{{item.id}}" bindtap="handleCancel">取消</view>
                    <view class="solid-button" wx:if="{{item.canPay}}" data-id="{{item.id}}" bindtap="handlePay">去支付</view>
                </view>
            </view>
        </view>
    </view>
</view>
